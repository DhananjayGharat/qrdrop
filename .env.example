# ============================================================
# QRDrop Production Environment Variables
# ============================================================

# Application Environment: development | production | test
APP_ENV=production

# Server network binding
# Set HOST=0.0.0.0 to listen on all interfaces for zero-config LAN discovery
HOST=0.0.0.0
PORT=8000

# Public 24/7 Global URL
# If hosting QRDrop publicly (e.g. https://qrdrop.app), set PUBLIC_URL.
# Generated pairing QR codes will encode this URL so any phone camera on any network
# (including 4G/5G mobile data) can scan and immediately connect.
PUBLIC_URL=https://qrdrop.app

# Default QR payload mode:
# - 'global': QR encodes PUBLIC_URL (with LAN fallback returned in handshake)
# - 'local': QR encodes local LAN IP:port directly
QR_MODE=global

# Session lifecycle configuration
# Ephemeral pairing token valid for 600s (10 minutes)
SESSION_TTL_SECONDS=600
# Once files are selected and transfer begins, TTL is extended to 1 hour
SESSION_ACTIVE_EXTEND_SECONDS=3600

# Distributed Session Store & Pub/Sub (Redis)
# Required for multi-worker / load-balanced API nodes and cross-node WebRTC signaling.
# When REDIS_ENABLED=false, QRDrop falls back seamlessly to in-memory state.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# STUN Servers (Comma-separated)
# Used for NAT discovery and direct browser-to-browser P2P WebRTC transfers
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN Servers (Comma-separated)
# Used for symmetric NAT / corporate firewall traversal via Coturn
TURN_SERVERS=turn:turn.qrdrop.app:3478,turns:turn.qrdrop.app:5349

# TURN Shared Secret for RFC 5766 REST API Ephemeral Credentials
# MUST MATCH static-auth-secret in deploy/turn/turnserver.conf!
TURN_SECRET=change-this-to-a-strong-random-secret-for-production
TURN_TTL_SECONDS=86400
