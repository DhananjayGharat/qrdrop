# QRDrop Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# Session & Security Settings
SESSION_TTL_SECONDS=120
MAX_PENDING_SESSIONS=1000
TOKEN_ENTROPY_BYTES=32

# Transfer Engine Configuration
DEFAULT_CHUNK_SIZE=262144        # 256 KB
MAX_CHUNK_SIZE=1048576           # 1 MB
MIN_CHUNK_SIZE=65536             # 64 KB
MAX_FILE_SIZE_BYTES=107374182400 # 100 GB
MAX_PARALLEL_CHUNKS=4

# STUN/TURN Configuration (for Direct P2P WebRTC)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Storage Directory for Receiver Downloads (Desktop default)
DEFAULT_DOWNLOAD_DIR=~/Downloads/QRDrop
DATABASE_PATH=qrdrop.db
